rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && userDoc(request.auth.uid).isAdmin == true;
    }
    function isBanned() {
      return isSignedIn() && userDoc(request.auth.uid).banned == true;
    }

    // ------- المستخدمون -------
    match /users/{uid} {
      allow read: if true; // لعرض الأسماء بجانب المشاريع والعروض
      allow create: if isSignedIn() && request.auth.uid == uid;
      // المستخدم يعدّل بياناته الخاصة لكن لا يمكنه تغيير isAdmin أو banned أو walletBalance بنفسه
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.isAdmin == resource.data.isAdmin &&
        request.resource.data.banned == resource.data.banned &&
        request.resource.data.walletBalance == resource.data.walletBalance
      );
      allow delete: if false;
    }

    // ------- المشاريع -------
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isSignedIn() && !isBanned() && request.resource.data.ownerId == request.auth.uid;
      // صاحب المشروع يحدّث الحالة/نسبة الإنجاز، والأدمن يحدّث العمولة
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();

      // ------- العروض -------
      match /bids/{bidId} {
        allow read: if true;
        allow create: if isSignedIn() && !isBanned()
                        && request.resource.data.freelancerId == request.auth.uid;
        // فقط صاحب المشروع يقبل/يرفض العروض
        allow update: if isSignedIn() &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow delete: if false;
      }

      // ------- الدردشة -------
      match /chat/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ------- محجوز لربط الدفع الإلكتروني مستقبلًا -------
    // عند إضافة بوابة دفع، أنشئ Cloud Functions تتحقق من العمليات وتحدّث walletBalance
    // بدلاً من السماح للمستخدمين بالكتابة المباشرة على أرصدتهم.
    match /transactions/{txId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // يُفعَّل لاحقًا عبر Cloud Functions فقط
    }
  }
}
